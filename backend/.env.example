# Copie este archivo a .env y ajuste los valores. NUNCA suba .env al repositorio.
NOTEMED_ENTORNO=desarrollo
NOTEMED_DATABASE_URL=sqlite:///./notemed.db
# En producción: al menos 32 caracteres aleatorios (p. ej. `openssl rand -hex 32`).
NOTEMED_JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-32-caracteres
NOTEMED_JWT_HORAS_EXPIRACION=8
# simulado | http (API compatible con chat completions)
NOTEMED_LLM_PROVEEDOR=simulado
NOTEMED_LLM_BASE_URL=
NOTEMED_LLM_API_KEY=
NOTEMED_LLM_MODELO=
NOTEMED_LLM_TIMEOUT_S=20
POSTGRES_PASSWORD=cambiar-me
